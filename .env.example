# .env.local 로 복사해서 채운다 (.env.local 은 git 에 올라가지 않는다). 값은 한글나라(Desktop/todo) .env.local 과 같다 — 아래 넷만 다르다.

# 로그인 계정 — 한글나라와 같은 값(아이디:비밀번호:역할, 역할 master 관리자 / child 아이)
ACCOUNTS=
# 로그인 열쇠 서명용 비밀 문자열 — Vercel 에 올릴 때는 꼭 넣는다
AUTH_SECRET=

# MongoDB — 한글나라와 같은 클러스터 주소
MONGODB_URI=
# 숫자놀이 진도 DB (기본 haonnumber) — 한글나라 DB 와 이름이 같으면 서버가 멈춘다(한글나라 진도 보호)
MONGO_DB=haonnumber
# 한글나라 DB (기본 todohangul) — 계정·설정을 읽기만 한다
HANGUL_DB=todohangul

# Typecast 음성 굽기 (scripts/typecast.mts) — 보이스동화·한글나라와 같은 키·크레딧
TYPECAST_API_KEY=
TYPECAST_VOICE_MINJEONG=
TYPECAST_VOICE_SUA=

# 그림 호스팅(회사 Cafe24) — 숫자놀이는 num 폴더. 배포(Vercel)에는 아래 두 줄만
CAFE24_PUBLIC_BASE_URL=
CAFE24_UPLOAD_DIR=/app/img/lsh/num/
# npm run image:upload 전용
CAFE24_FTP_HOST=
CAFE24_FTP_PORT=
CAFE24_FTP_USER=
CAFE24_FTP_PASS=
